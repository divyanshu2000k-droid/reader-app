{
  // The files that run under Node rather than on a phone, and only those, get the Node
  // globals: the tests (under `tsx --test`) and app.config.ts (evaluated by the Expo CLI,
  // which reads the font files from disk to fail the build if one is missing). `node:test`,
  // `node:fs` and `__dirname` are legitimate there and nowhere else.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/__tests__/**/*.ts", "app.config.ts"],
  // The base config excludes both; this one is only about them.
  "exclude": ["node_modules", "android", "ios"]
}
