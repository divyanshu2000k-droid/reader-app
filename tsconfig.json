{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // EMPTY, deliberately. This used to be ["node"], which put `process`, `Buffer` and
    // the rest of the Node globals in scope for APP code: it typechecks, it lints, and
    // it crashes on the device. The test files genuinely need them, so they typecheck
    // under tsconfig.test.json instead. `npm run typecheck` runs both.
    "types": [],
    "noUncheckedIndexedAccess": true,
    // An optional property may be ABSENT, but not present with the value `undefined`, unless
    // its type says so. Turned on for the write path: `updateRow(t, id, { note: undefined })`
    // used to typecheck, run `SET updated_at = ?` alone and queue a sync for an edit that
    // never happened. The runtime rule in write.ts is the guarantee; this is the early
    // warning. See src/db/__tests__/write.types.ts.
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/features/*": ["./src/features/*"],
      "@/ui/*": ["./src/ui/*"],
      "@/db/*": ["./src/db/*"],
      "@/domain/*": ["./src/domain/*"],
      "@/lib/*": ["./src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // app.config.ts runs in Node, not on the phone: it typechecks under tsconfig.test.json.
  "exclude": ["node_modules", "android", "ios", "src/**/__tests__/**", "app.config.ts"]
}
